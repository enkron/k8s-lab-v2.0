#cloud-config

hostname: upstream-router
manage_etc_hosts: true

users:
  - name: k8s
    gecos: Kubernetes Admin
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOKYBETvhOvIuZY9TzIS6R2bQMRZOW3lDQuttbi35oiU enkron

growpart:
  mode: auto
  devices: ['/']

resize_rootfs: true

ssh_pwauth: false
disable_root: true

timezone: UTC

package_update: true
package_upgrade: true

final_message: "cloud-init completed for upstream-router ($UPTIME s)"
