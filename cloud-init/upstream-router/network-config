version: 2
ethernets:
  mgmt:
    match:
      macaddress: "52:54:00:00:01:00"
    dhcp4: false
    dhcp6: false
    addresses:
      - 192.168.100.13/24
    # `gateway4` is deprecated in netplan/cloud-init v2; default routes live under `routes`.
    routes:
      - to: default
        via: 192.168.100.2
    nameservers:
      addresses:
        - 192.168.100.3
  internal:
    match:
      macaddress: "52:54:00:00:02:00"
    dhcp4: false
    dhcp6: false
    # No SLAAC: infrastructure uses static IPv6 addressing.
    accept-ra: false
    # Static addresses on the shared VDE segment. The eBGP session with the Route
    # Reflector on control-plane-1 (fd00:100::10) terminates here; the IPv4 address gives
    # the IPv4 default route a reachable next hop.
    addresses:
      - fd00:100::1/64
      - 10.100.0.1/24
